{
  "name": "@lmoesle/camunda-cli",
  "version": "0.8.0",
  "description": "CLI for interacting with Camunda 8",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmoesle/camunda-cli"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "camunda-cli": "dist/bin/camunda-cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:operate-api": "openapi-generator-cli generate -i resources/operate-8.7/operate-openapi.yaml -g typescript-axios -c resources/operate-8.7/generator-config.json -t resources/operate-8.7/generator-templates -o src/adapter/out/generated/operate --global-property apis,models,apiDocs=false,modelDocs=false,apiTests=false,modelTests=false,supportingFiles=api.ts:base.ts:common.ts:configuration.ts:index.ts",
    "build": "webpack",
    "lint": "eslint . && fallow src",
    "prepack": "npm run build",
    "start": "npm run build && node dist/bin/camunda-cli.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "commander": "^15.0.0",
    "fallow": "^3.31.0",
    "lossless-json": "^4.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
