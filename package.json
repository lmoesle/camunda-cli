{
  "name": "@lmoesle/camunda-cli",
  "version": "0.3.0",
  "description": "CLI for interacting with Camunda 8",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmoesle/camunda-cli"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "camunda-cli": "dist/bin/camunda-cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "webpack",
    "lint": "eslint . && fallow src",
    "prepack": "npm run build",
    "start": "npm run build && node dist/bin/camunda-cli.js",
    "test": "jest"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "commander": "^14.0.3",
    "fallow": "^3.31.0",
    "lossless-json": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
